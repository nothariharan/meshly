{
  "name": "meshly-workspace",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Meshly — The Operating Layer for Autonomous Workers",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "tsx workflows/reconciliation/index.ts",
    "demo": "tsx workflows/reconciliation/index.ts",
    "console": "tsx apps/console/src/server.ts",
    "simulate": "tsx packages/cli/src/index.ts simulate 100",
    "workflow:reconciliation": "tsx workflows/reconciliation/index.ts",
    "workflow:research": "tsx workflows/browser-research/index.ts",
    "workflow:desktop": "tsx workflows/desktop-operation/index.ts",
    "test": "tsx tests/run-all.ts",
    "test:invariants": "tsx tests/invariants/invariants.test.ts",
    "test:failure": "tsx tests/failure/failure.test.ts",
    "test:security": "tsx tests/security/security.test.ts",
    "test:verification": "tsx tests/verification/verification.test.ts",
    "cli": "tsx packages/cli/src/index.ts"
  },
  "dependencies": {
    "@solarisdk/browser": "^0.1.3",
    "@solarisdk/sdk": "^0.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
