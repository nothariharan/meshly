{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@meshly/core": ["packages/core/src/index.ts"],
      "@meshly/solari": ["packages/solari/src/index.ts"],
      "@meshly/sdk": ["packages/sdk/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "apps/*/src/**/*",
    "workflows/**/*",
    "tests/**/*"
  ],
  "exclude": ["node_modules", "dist", "cookbook"]
}
